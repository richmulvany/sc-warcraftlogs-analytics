# Copy to backend/.env and fill in. Never commit real values.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=03_gold
DATABRICKS_SCHEMA=sc_analytics

SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=30

# Auth: shared-secret API key. When set, /chat requires X-API-Key: <value>.
# Leave empty for local dev; set in Azure (Container Apps secrets) for prod.
# CHATBOT_BACKEND_API_KEY is the canonical name; CHATBOT_API_KEY also works.
CHATBOT_BACKEND_API_KEY=

# CORS: comma-separated origin allowlist. Default "*" for local dev.
# In production set to your frontend origin(s), e.g.
#   CHATBOT_CORS_ORIGINS=https://sc-analytics.org,https://www.sc-analytics.org
CHATBOT_CORS_ORIGINS=*
